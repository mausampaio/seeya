{
  // Flat, non-composite whole-repo type checker (V2-T1): a single TS program over both packages'
  // source AND tests/, so a test that misuses a type in packages/engine or packages/cli is still
  // caught in one pass — exactly what `tsc -p tsconfig.json --noEmit` did before the monorepo
  // split. Deliberately NOT part of the `tsc -b` project-reference graph (tsconfig.build.json):
  // this program never emits and must never require a prior build, mirroring how tests resolve
  // `@seeya-ai/engine` to source (see "paths" below), not to `packages/engine/dist`.
  //
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // V2-T1 (D-043): `@seeya-ai/engine`'s package.json "exports" point at its build output, so
    // that the *published* boundary is what cli actually runs against. Type-checking (this file)
    // and the test suite (vitest.config.ts's alias) both bypass that and resolve straight to
    // source instead, so neither depends on a build having happened first — same reasoning as
    // D-020's "no test touches disk": here, no check touches `dist/`.
    "paths": {
      "@seeya-ai/engine/*": ["./packages/engine/src/*"]
    }
  },
  "include": [
    "packages/engine/src",
    "packages/cli/src",
    "tests",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
