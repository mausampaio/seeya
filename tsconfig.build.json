{
  // Solution file for `tsc -b` (V2-T1, D-043): builds every package in dependency order and
  // nothing else. `files: []` means this config itself has no source of its own; it only
  // orchestrates its references. `npm run build` runs `tsc -b tsconfig.build.json`.
  //
  "files": [],
  "references": [
    { "path": "packages/engine/tsconfig.build.json" },
    { "path": "packages/cli/tsconfig.build.json" },
    // V2-T2: @seeya-ai/app declares its build config as packages/app/tsconfig.json, not
    // tsconfig.build.json (see that file's own comment for why) — this reference still points
    // `tsc -b` at it the same way, tsc -b doesn't care about the filename.
    { "path": "packages/app/tsconfig.json" }
  ]
}
