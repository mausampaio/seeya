{
  "name": "@seeya-ai/app",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop interface for seeya: an embedded terminal for reviewing and resuming discovered Claude Code sessions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/electron/main.js",
  "author": {
    "name": "mausampaio",
    "email": "noreply@seeya.invalid"
  },
  "desktopName": "seeya.desktop",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev",
    "dist": "npm run build && node scripts/dist.mjs",
    "dist:windows": "npm run build && node scripts/dist.mjs --win",
    "dist:linux": "npm run build && node scripts/dist.mjs --linux",
    "dist:mac": "npm run build && node scripts/dist.mjs --mac"
  },
  "dependencies": {
    "@seeya-ai/cli": "0.1.0",
    "@seeya-ai/engine": "0.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mausampaio/seeya.git",
    "directory": "packages/app"
  },
  "license": "MIT"
}
